{
  "name": "studyai",
  "version": "0.4.0",
  "description": "Workspace pessoal de estudos com IA, offline e multiplataforma.",
  "author": "StudyAI",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:pack": "npm run build && electron-builder --dir --config electron-builder.yml",
    "desktop:build": "npm run build && electron-builder --win nsis --config electron-builder.yml",
    "mobile:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^0.577.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.2.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.3.0",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "typescript": "^5.9.0",
    "wait-on": "^9.1.0"
  }
}
