# Aplicação (desenvolvimento local)
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
STUDYAI_DOMAIN=localhost

# Autenticação e diagnóstico
AUTH_SECRET=
HEALTH_SECRET=
# Segredo dedicado (>= 32 chars) para o endpoint administrativo POST /api/internal/maintenance/cleanup.
MAINTENANCE_SECRET=
# Chave dedicada ao envelope BYOK v2 (openssl rand -base64 32).
# Sem ela, novas chaves são gravadas em v1 (legado).
API_KEYS_ENCRYPTION_KEY=

# Rate limit por IP atrás de proxy confiável (Railway, Caddy, Nginx).
# Em desenvolvimento local pode ficar vazio. Ver .env.production.example.
TRUST_PROXY_HEADERS=
TRUSTED_PROXY_HOPS=1

# PostgreSQL / Docker Compose
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10

# Object Storage S3 compatível
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# IA remota (server-side)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Governança de quotas de IA compartilhada (valores em requisições e TOKENS; não é teto financeiro monetário)
AI_USER_DAILY_REQUEST_LIMIT=500
AI_USER_MINUTE_REQUEST_LIMIT=20
AI_USER_DAILY_TOKEN_LIMIT=250000
AI_GLOBAL_DAILY_TOKEN_BUDGET=5000000
AI_RESERVATION_TTL_MS=300000

# Cotas acumuladas de armazenamento por conta (convenção binária MiB: 1 MiB = 1.048.576 bytes)
# Padrão: 1.024 MiB (1 GiB) arquivos e 200 MiB backups
STORAGE_FILES_QUOTA_BYTES=1073741824
STORAGE_BACKUPS_QUOTA_BYTES=209715200
STORAGE_RESERVATION_TTL_MS=300000

# Ollama é opcional e somente local por padrão
OLLAMA_URL=http://localhost:11434

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=StudyAI <noreply@example.com>
FEEDBACK_EMAIL=

# Aplicativos Capacitor
CAPACITOR_SERVER_URL=https://app.example.com
