# Aplicação (desenvolvimento local)
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
STUDYAI_DOMAIN=localhost

# Autenticação e diagnóstico
AUTH_SECRET=
HEALTH_SECRET=

# PostgreSQL / Docker Compose
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10

# Object Storage S3 compatível
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# IA remota (server-side)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Ollama é opcional e somente local por padrão
OLLAMA_URL=http://localhost:11434

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=StudyAI <noreply@example.com>
FEEDBACK_EMAIL=

# Aplicativos Capacitor
CAPACITOR_SERVER_URL=https://app.example.com
