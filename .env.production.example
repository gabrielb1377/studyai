# Aplicação pública
NODE_ENV=production
APP_URL=https://studyai.example.com
NEXT_PUBLIC_APP_URL=https://studyai.example.com
STUDYAI_DOMAIN=studyai.example.com

# Segurança: gere valores longos, aleatórios e diferentes por ambiente
AUTH_SECRET=
HEALTH_SECRET=

# PostgreSQL gerenciado
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10

# Object Storage S3 compatível (obrigatório em produção)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# Providers remotos server-side; configure ao menos um
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Opcional: somente se houver um Ollama acessível pelo servidor cloud
OLLAMA_URL=

# Email transacional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=StudyAI <noreply@example.com>
FEEDBACK_EMAIL=

# Mobile
CAPACITOR_SERVER_URL=https://studyai.example.com
