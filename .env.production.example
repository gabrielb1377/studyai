# Aplicação pública
NODE_ENV=production
APP_URL=https://studyai.example.com
NEXT_PUBLIC_APP_URL=https://studyai.example.com
STUDYAI_DOMAIN=studyai.example.com

# Segurança: gere valores longos, aleatórios e diferentes por ambiente
AUTH_SECRET=
HEALTH_SECRET=
# Segredo dedicado (>= 32 chars) para o endpoint administrativo POST /api/internal/maintenance/cleanup.
# Sem ele (ou menor que 32 caracteres), o endpoint responde 503 (desativado).
MAINTENANCE_SECRET=
# Chave dedicada ao envelope BYOK v2 (openssl rand -base64 32).
# Obrigatória para gravar novas chaves em v2. Nunca remova após gravar v2
# sem antes reencriptar os registros (ver docs/ROLLBACK_V1_1.md).
API_KEYS_ENCRYPTION_KEY=

# Endereço do cliente para rate limit por IP (obrigatório fora da Vercel).
# Ative somente se a origem estiver isolada e o proxy acrescentar seu par ao X-Forwarded-For.
# X-Real-IP não é usado. Sem fonte confiável, a readiness fica degradada.
TRUST_PROXY_HEADERS=
# Quantidade de proxies confiáveis na frente da aplicação (lida da direita em X-Forwarded-For).
TRUSTED_PROXY_HOPS=1

# PostgreSQL gerenciado
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10

# Object Storage S3 compatível (obrigatório em produção)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# Providers remotos server-side; configure ao menos um
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Governança de quotas de IA compartilhada (valores em requisições e TOKENS; não representa teto financeiro exato)
# Defina limites adequados ao seu volume antes do lançamento.
AI_USER_DAILY_REQUEST_LIMIT=500
AI_USER_MINUTE_REQUEST_LIMIT=20
AI_USER_DAILY_TOKEN_LIMIT=250000
AI_GLOBAL_DAILY_TOKEN_BUDGET=5000000
AI_RESERVATION_TTL_MS=300000

# Cotas acumuladas de armazenamento por conta (convenção binária MiB: 1 MiB = 1.048.576 bytes)
# Padrão: 1.024 MiB (1.073.741.824 bytes) para arquivos e 200 MiB (209.715.200 bytes) para backups
STORAGE_FILES_QUOTA_BYTES=1073741824
STORAGE_BACKUPS_QUOTA_BYTES=209715200
STORAGE_RESERVATION_TTL_MS=300000

# Opcional: somente se houver um Ollama acessível pelo servidor cloud
OLLAMA_URL=

# Email transacional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=StudyAI <noreply@example.com>
FEEDBACK_EMAIL=

# Mobile
CAPACITOR_SERVER_URL=https://studyai.example.com
